    11: 1,
    12: 1
})

df_modelo = df.dropna(subset=['risco_grave']).copy()
df_modelo['risco_grave'] = df_modelo['risco_grave'].astype(int)

print("Distribuição absoluta:")
print(df_modelo['risco_grave'].value_counts())

print("\nDistribuição percentual:")
print((df_modelo['risco_grave'].value_counts(normalize=True) * 100).round(2))

